  "atrous_rates": [
    6,
    12,
    18
  ],
  "attention_probs_dropout_prob": 0.0,
  "classifier_dropout_prob": 0.1,
  "conv_kernel_size": 3,
  "dtype": "float32",
  "expand_ratio": 4.0,
  "hidden_act": "silu",
