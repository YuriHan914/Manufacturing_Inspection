    144,
    192,
    240
  ],
  "id2label": {
    "0": "Center",
    "1": "Donut",
    "2": "Edge-Loc",
    "3": "Edge-Ring",
    "4": "Local",
    "5": "Near-Full",
    "6": "Normal",
    "7": "Random",
    "8": "Scratch"
  },
  "image_size": 256,
  "initializer_range": 0.02,
  "label2id": {
    "Center": 0,
    "Donut": 1,
    "Edge-Loc": 2,
    "Edge-Ring": 3,
    "Local": 4,
    "Near-Full": 5,
    "Normal": 6,
    "Random": 7,
    "Scratch": 8
  },
  "layer_norm_eps": 1e-05,
  "mlp_ratio": 2.0,
  "model_type": "mobilevit",
  "neck_hidden_sizes": [
    16,
    32,
    64,
    96,
    128,
    160,
    640
